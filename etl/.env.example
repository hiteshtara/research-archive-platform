# Copy this file to .env and fill in real values for your environment.
# .env is gitignored - never commit real credentials.
#
# These loaders read configuration from the process environment, not from
# this file directly. Use direnv, `set -a; source .env; set +a`, or your
# shell/CI secrets manager to export these before running any script.

# --- Oracle (Kuali source database) ---------------------------------------
# Required by: scripts/test_oracle_connection.py, load_*_from_csv.py --oracle,
# archive_attachments.py, archive_subaward_attachments.py, export_protocol_versions.py,
# and all load_protocol_*.py scripts.
# ORACLE_DSN is a full connect descriptor or an Easy Connect string, e.g.
# "kuali-oracle.bu.edu:1521/KCPROD". Requires BU VPN/network access.
# python-oracledb runs in thin mode by default - no Oracle Instant Client
# install is required.
ORACLE_USER=changeme
ORACLE_PASSWORD=changeme
ORACLE_DSN=changeme:1521/changeme

# --- PostgreSQL (Research Archive target database) -------------------------
# Required by every load_*.py script and scripts/test_postgres_connection.py.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=research_archive
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
# Optional. Defaults to "prefer" (libpq's own default). Use "require" or
# "verify-full" for BU's RDS instance once TLS is configured.
POSTGRES_SSLMODE=prefer

# --- AWS S3 (IRB export landing zone) ---------------------------------------
# Required by: load_from_s3.py, load_composite_from_s3.py, run_export.py,
# run_composite_export.py.
DATA_BUCKET_NAME=changeme-data-bucket
# Optional, defaults to us-east-1.
AWS_REGION=us-east-1
# Optional, defaults to "landing/irb/". Only read by load_from_s3.py.
IRB_S3_PREFIX=landing/irb/
