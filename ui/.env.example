# Copy relevant lines into .env.local (gitignored) for local development.
# In deployed environments these are all set by Terraform as Amplify
# build-time environment variables - see terraform/environments/*/main.tf
# (module.amplify.environment_variables). Never hardcode any of these
# values in source.

VITE_API_BASE_URL=http://localhost:8080

# Cognito - get these from `terraform output` in the environment you're
# testing against (or from an existing manually-created pool for local-only
# work): cognito_user_pool_id, cognito_client_id, cognito_hosted_ui_domain
# (strip the https:// prefix), aws_region.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_changeme
VITE_COGNITO_CLIENT_ID=changeme
VITE_COGNITO_DOMAIN=changeme.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URL=http://localhost:5173/
VITE_COGNITO_LOGOUT_URL=http://localhost:5173/

# Optional: approved origins this UI may redirect back to after login/logout,
# comma-separated. Must mirror the Cognito app client's callback URLs - an
# origin not listed here is ignored and the build-time
# VITE_COGNITO_REDIRECT_URL is used instead. Set this when one build is served
# at more than one approved address (e.g. the Amplify URL and a custom domain)
# so a login started at either address returns to that same address. Not a
# secret. Leave unset for single-origin environments.
# VITE_COGNITO_ALLOWED_ORIGINS=http://localhost:5173/,https://main.d288p9gmoteftb.amplifyapp.com/,https://nonprod.kuali-archive.bu.edu/

# Optional: name of the Cognito identity provider offered by the "Sign in with
# BU" button. Terraform creates one named "BUShibboleth" when
# shibboleth_idp_metadata_url is set. Not a secret.
#
# When set, the sign-in screen shows TWO buttons - "Sign in with BU" (straight
# to this provider) and "Sign in with Cognito" (the Hosted UI, where native
# archive accounts live). Native login therefore stays reachable either way;
# leave this unset to show only the Cognito button, which is today's behaviour.
#
# Set it together with VITE_COGNITO_LOGOUT_URL below: signing out of Cognito
# without also ending the BU IdP session sends a federated user straight back
# in with no prompt, so logout appears to do nothing.
# VITE_COGNITO_IDENTITY_PROVIDER=BUShibboleth
#
# BU's logout page, confirmed by Kevin Ruderman (INC21002534). Use this, NOT
# /idp/profile/Logout: that is the SAML single-logout profile endpoint, and
# BU's IdP advertises no SingleLogoutService, so it cannot complete. This URL
# must also appear in the Cognito app client's logout URLs.
# VITE_COGNITO_LOGOUT_URL=https://shib-test.bu.edu/idp/logout.jsp

# AI features (optional, default off)
VITE_AI_ENABLED=false
VITE_AI_QUESTIONS_ENABLED=false
