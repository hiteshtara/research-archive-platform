# Copy relevant lines into .env.local (gitignored) for local development.
# In deployed environments these are all set by Terraform as Amplify
# build-time environment variables - see terraform/environments/*/main.tf
# (module.amplify.environment_variables). Never hardcode any of these
# values in source.

VITE_API_BASE_URL=http://localhost:8080

# Cognito - get these from `terraform output` in the environment you're
# testing against (or from an existing manually-created pool for local-only
# work): cognito_user_pool_id, cognito_client_id, cognito_hosted_ui_domain
# (strip the https:// prefix), aws_region.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_changeme
VITE_COGNITO_CLIENT_ID=changeme
VITE_COGNITO_DOMAIN=changeme.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URL=http://localhost:5173/
VITE_COGNITO_LOGOUT_URL=http://localhost:5173/

# Optional: approved origins this UI may redirect back to after login/logout,
# comma-separated. Must mirror the Cognito app client's callback URLs - an
# origin not listed here is ignored and the build-time
# VITE_COGNITO_REDIRECT_URL is used instead. Set this when one build is served
# at more than one approved address so a login started at either address
# returns to that same address. Not a secret. Leave unset for single-origin
# environments.
#
# The retired *.amplifyapp.com origin stays listed here deliberately: it still
# serves the build, so a login that starts there must still be able to finish
# there. VITE_CANONICAL_ORIGIN below is what moves people off it.
# VITE_COGNITO_ALLOWED_ORIGINS=http://localhost:5173/,https://main.d288p9gmoteftb.amplifyapp.com/,https://nonprod.kuali-archive.bu.edu/

# Optional: the single advertised origin for this deployment. When set, a
# visitor arriving on any other origin is redirected here, keeping the path and
# safe query parameters. OAuth parameters (code, state, tokens) are stripped
# rather than forwarded - an authorization code is bound to the redirect_uri it
# was issued for, so forwarding one would fail and would copy a credential onto
# another origin for no reason. localhost is never redirected, and the
# canonical origin itself is never redirected, which is what prevents a loop.
#
# Amplify Hosting cannot disable its default *.amplifyapp.com domain, so this
# is a courtesy redirect onto the official URL rather than an access control -
# the old origin keeps serving the same public bundle either way.
#
# ROLLBACK: clear this variable and rebuild. Every origin then serves the
# application directly again, which is what you want if the custom domain
# becomes unavailable.
# VITE_CANONICAL_ORIGIN=https://nonprod.kuali-archive.bu.edu

# Optional: name of the Cognito identity provider to send users straight to.
# Terraform creates one named "BUShibboleth" when shibboleth_idp_metadata_url
# is set. Not a secret - just an identifier.
#
# When set, opening the application redirects to BU Web Login immediately. No
# provider chooser and no native username/password screen is shown. Cognito is
# still the authentication gateway - it issues the tokens and holds the user
# pool - it just stops being a screen anyone sees.
#
# EMERGENCY ROLLBACK: clear this variable and rebuild. The application falls
# back to Cognito's Hosted UI and the native user pool accounts work again.
# No code change is needed, so this is the fastest way back if BU Web Login
# or the SAML federation breaks.
# VITE_COGNITO_IDENTITY_PROVIDER=BUShibboleth
#
# When VITE_COGNITO_IDENTITY_PROVIDER is set, VITE_COGNITO_LOGOUT_URL must be
# the IdP's logout FLOW, not an application URL:
#
#   VITE_COGNITO_LOGOUT_URL=https://shib-test.bu.edu/idp/profile/Logout
#
# Cognito's /logout ends Cognito's session only. BU's SSO session outlives it
# and answers the next sign-in with no prompt, so sign-out appears to do
# nothing. Handing the browser to the IdP's logout flow is what ends it.
# Deployed and verified in dev on 2026-10-23 - see docs/shibboleth/LOGOUT.md.
#
#   * The URL must ALSO be listed in cognito_logout_urls, or Cognito refuses
#     sign-out with HTTP 400 "Required parameters missing" rather than
#     redirecting. Apply that Terraform change BEFORE deploying a build that
#     uses this value.
#   * Do NOT use https://shib-test.bu.edu/idp/logout.jsp. It answers 200 and
#     displays "You have successfully logged out", but it expires cookies
#     named shib_idp_session, shib_idp_session_ss, _idp_session and
#     JSESSIONID at Path=/idp - while the cookie the IdP actually sets is
#     __Host-shib_idp_session at Path=/. The names do not match, the session
#     survives, and the user is signed straight back in. Clean-browser
#     testing on 2026-10-23 confirmed /idp/profile/Logout removes
#     __Host-shib_idp_session and forces a fresh BU password challenge, and
#     that logout.jsp does not. An earlier revision of this file claimed the
#     opposite; that claim came from a browser profile that already held a BU
#     session and is withdrawn.
#   * BU's IdP advertises no SingleLogoutService, so logout across all BU
#     services is still not available and must not be promised to users. That
#     is a separate thing from ending this IdP's own browser session, which
#     /idp/profile/Logout does.
#   * PRODUCTION IS UNVERIFIED. https://shib.bu.edu/idp/profile/Logout has
#     never been tested against an authenticated production session. Do not
#     assume it matches test - logout.jsp is itself proof that a plausible BU
#     logout URL can return 200, claim success, and leave the session usable.
#
# ROLLBACK: set this back to an application URL (above) and rebuild. The UI
# then restores its /signed-out page and the deliberate-sign-out marker on its
# own. Keep both URLs in cognito_logout_urls so no Terraform change is needed
# to go back. This is also the configuration to use if native Cognito rollback
# users need to return to the archive after logout rather than landing on a
# BU page.

# AI features (optional, default off)
VITE_AI_ENABLED=false
VITE_AI_QUESTIONS_ENABLED=false
