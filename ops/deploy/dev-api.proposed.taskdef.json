{
  "family": "research-archive-platform-dev-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::770203350335:role/research-archive-platform-dev-api-execution-role",
  "taskRoleArn": "arn:aws:iam::770203350335:role/research-archive-platform-dev-api-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "770203350335.dkr.ecr.us-east-1.amazonaws.com/research-archive-platform-dev-api@sha256:ccfb5d598d9bd61a5e2f0aa59494031b1908b479fc06d00518e24365589199d1",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "APP_EXPLORER_ENABLED",
          "value": "true"
        },
        {
          "name": "APP_CORS_ALLOWED_ORIGINS",
          "value": "http://localhost:5173,https://main.d288p9gmoteftb.amplifyapp.com,https://nonprod.kuali-archive.bu.edu"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "aws"
        },
        {
          "name": "APP_SEARCH_SEMANTIC_ENABLED",
          "value": "true"
        },
        {
          "name": "COGNITO_ISSUER_URI",
          "value": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_VJ4ekQ27c"
        },
        {
          "name": "ARCHIVE_DOCUMENTS_BUCKET",
          "value": "research-archive-platform-dev-documents-770203350335"
        },
        {
          "name": "COGNITO_CLIENT_ID",
          "value": "seqgmc8sccr22sq8lcafqjcpb"
        },
        {
          "name": "APP_SEARCH_TIMING_ENABLED",
          "value": "false"
        }
      ],
      "secrets": [
        {
          "name": "POSTGRES_DB",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:770203350335:secret:research-archive-platform/dev/postgres-4k6Ngz:dbname::"
        },
        {
          "name": "POSTGRES_HOST",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:770203350335:secret:research-archive-platform/dev/postgres-4k6Ngz:host::"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:770203350335:secret:research-archive-platform/dev/postgres-4k6Ngz:password::"
        },
        {
          "name": "POSTGRES_PORT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:770203350335:secret:research-archive-platform/dev/postgres-4k6Ngz:port::"
        },
        {
          "name": "POSTGRES_USER",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:770203350335:secret:research-archive-platform/dev/postgres-4k6Ngz:username::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/research-archive-platform-dev-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
