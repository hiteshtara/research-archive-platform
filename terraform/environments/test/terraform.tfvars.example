# Copy to terraform.tfvars and fill in real values. Never put
# amplify_github_access_token or any other secret here - export
# TF_VAR_amplify_github_access_token instead.

expected_account_id = "REPLACE_WITH_YOUR_12_DIGIT_ACCOUNT_ID"

aws_region   = "us-east-1"
project_name = "research-archive-platform"
environment  = "test"

# Distinct from dev's 10.30.0.0/16 and prod's 10.32.0.0/16 in case these
# VPCs are ever peered or connected via Transit Gateway.
vpc_cidr = "10.31.0.0/16"

public_subnet_cidrs = [
  "10.31.1.0/24",
  "10.31.2.0/24"
]

private_subnet_cidrs = [
  "10.31.11.0/24",
  "10.31.12.0/24"
]

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

database_allowed_cidrs = []

enable_nat_gateway          = false
use_private_subnets_for_api = false

database_name                  = "research_archive"
database_master_username       = "archive_admin"
database_instance_class        = "db.t4g.small"
database_deletion_protection   = true
database_skip_final_snapshot   = false
database_backup_retention_days = 14
database_multi_az              = false
database_apply_immediately     = true

api_image_tag            = "REPLACE_WITH_A_REAL_IMAGE_TAG"
loader_image_tag         = "REPLACE_WITH_A_REAL_IMAGE_TAG"
ecr_image_tag_mutability = "IMMUTABLE"
ecr_force_delete         = false

api_container_port      = 8080
api_desired_count       = 1
alb_deletion_protection = true

# Set all three together once you have a domain, its Route53 zone, and an
# ACM certificate covering it - see README's "Production HTTPS and DNS".
api_domain_name     = null
api_certificate_arn = null
api_route53_zone_id = null

manage_cognito = true
cognito_callback_urls = [
  "https://REPLACE_WITH_YOUR_TEST_UI_DOMAIN/"
]
cognito_logout_urls = [
  "https://REPLACE_WITH_YOUR_TEST_UI_DOMAIN/"
]
cognito_advanced_security_mode = "AUDIT"
cognito_deletion_protection    = true
cognito_mfa_configuration      = "OFF"

# Leave amplify_repository_url/amplify_github_access_token BOTH unset
# (recommended) to connect the repo manually via the AWS Console's GitHub
# App flow after the first apply - see README's "Amplify repository
# connection" section. Shown here is the legacy PAT-based alternative
# (never put the token in this file - export
# TF_VAR_amplify_github_access_token instead).
manage_amplify         = true
amplify_repository_url = "https://github.com/REPLACE_WITH_ORG/REPLACE_WITH_REPO"
amplify_branch_name    = "test"
# ui_redirect_url/ui_logout_url are only needed if amplify_custom_domain is
# not set - see README's Amplify + Cognito bring-up note.
# ui_redirect_url = "https://REPLACE_AFTER_FIRST_APPLY/"
# ui_logout_url   = "https://REPLACE_AFTER_FIRST_APPLY/"

# Leave false (the default) to deploy without ever requiring an OpenAI
# secret. See README's "Enable and populate the OpenAI secret" section.
# enable_openai_secret = true
# additional_api_environment_variables = {
#   APP_AI_ENABLED        = "true"
#   APP_AI_PROVIDER       = "openai"
#   APP_AI_OPENAI_ENABLED = "true"
# }
