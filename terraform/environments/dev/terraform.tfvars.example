# Copy to terraform.tfvars and fill in real values for your account.
# terraform.tfvars is gitignored (see terraform/.gitignore) - it is NOT
# tracked in git and never has been, despite an earlier version of this
# comment claiming otherwise. That false claim, combined with dev's
# real terraform.tfvars existing only on individual machines, is part
# of how dev's Cognito configuration once silently pointed at a user
# pool in a different AWS account for an unknown period - see
# docs/architecture/AWARD_IMPLEMENTATION_ROADMAP.md's "Twelfth same-day
# follow-up." Treat this file (the tracked example) as the source of
# truth for what dev's terraform.tfvars *should* contain; don't assume
# an existing local terraform.tfvars is correct just because it exists.
#
# Never put amplify_github_access_token, or any other secret, in this file
# or in terraform.tfvars. Pass secrets via TF_VAR_<name> environment
# variables instead.

# --- Account safety --------------------------------------------------------

# Run `aws sts get-caller-identity` and confirm this matches before applying.
expected_account_id = "REPLACE_WITH_YOUR_12_DIGIT_ACCOUNT_ID"

# --- Core --------------------------------------------------------------

aws_region   = "us-east-1"
project_name = "research-archive-platform"
environment  = "dev" # one of: dev, test, prod

# --- Networking ----------------------------------------------------------

vpc_cidr = "10.30.0.0/16"

public_subnet_cidrs = [
  "10.30.1.0/24",
  "10.30.2.0/24"
]

private_subnet_cidrs = [
  "10.30.11.0/24",
  "10.30.12.0/24"
]

availability_zones = [
  "us-east-1a",
  "us-east-1b"
]

database_allowed_cidrs = []

# Only needed if use_private_subnets_for_api = true below.
enable_nat_gateway          = false
use_private_subnets_for_api = false

# BU Oracle staging connectivity (etl/load_award_attachments.py --ecs).
# These resources already exist as manually created AWS infrastructure -
# see docs/ORACLE_STAGING_CONNECTIVITY.md for the terraform import
# commands needed to adopt them, and for which of these are owned by
# this project versus shared BU infrastructure.
enable_oracle_peering = true
oracle_vpc_id         = "vpc-0290de1785982a52f" # BU Oracle staging VPC - not managed by this project
oracle_subnet_cidrs = [
  "10.58.33.0/25",
  "10.58.33.128/25"
]
oracle_route_table_ids = [
  "rtb-03aee2071636aad9e", # BU-owned - only the one return route is managed here
  "rtb-04ca6e1a522dc2b08"
]
oracle_security_group_id = "sg-019199c2d80636821" # BU-owned Oracle RDS security group - only one ingress rule is managed here

# --- Database ------------------------------------------------------------

database_name             = "research_archive"
database_master_username  = "archive_admin"
database_instance_class   = "db.t4g.micro"
database_deletion_protection    = false
database_skip_final_snapshot    = true
database_backup_retention_days  = 7
database_multi_az               = false
database_apply_immediately      = true

# --- Container images ------------------------------------------------------

# Avoid "latest" beyond initial bring-up - pin to a real tag (git SHA or
# release) once you have a build pipeline producing one.
api_image_tag            = "latest"
loader_image_tag         = "latest"
ecr_image_tag_mutability = "MUTABLE"
ecr_force_delete         = true

# --- API service -----------------------------------------------------------

api_container_port      = 8080
api_desired_count       = 1
alb_deletion_protection = false

# --- Domain / TLS ------------------------------------------------------

# Leave all three null to bring up the ALB on plain HTTP first (fine in
# dev/test; prod requires a certificate - see README's "Production HTTPS
# and DNS" section). Once you have a domain, its Route53 zone, and an ACM
# certificate covering it, set all three together.
api_domain_name      = null
api_certificate_arn  = null
api_route53_zone_id  = null

# --- Cognito -------------------------------------------------------------

# Option A (shown here, and what dev actually uses): let Terraform
# create and own the User Pool via modules/cognito - a public SPA app
# client (no client secret, authorization-code OAuth flow, Cognito-only
# sign-in). Prefer this over Option B unless you are deliberately
# adopting a pool that already exists *in this same AWS account* -
# bringing in a pool ID/issuer from any other account will silently
# misconfigure both the API and the UI with no error until someone
# tries to actually authenticate (see the incident referenced above).
manage_cognito         = true
cognito_callback_urls  = ["https://REPLACE_WITH_YOUR_UI_DOMAIN/"]
# Cognito only redirects to a URL on this allow-list, so the UI's public
# post-logout page has to be listed as well as the application root. The UI
# sends Cognito to /signed-out (SIGNED_OUT_PATH in ui/src/auth.ts): returning
# to "/" lands behind the auth gate, which immediately starts a fresh identity
# provider redirect, and a still-valid SSO session signs the user straight back
# in - sign-out then appears to do nothing. Keep the root entry as well; it is
# still a valid logout target and removing it would break any older build.
#
# When the UI signs in through a SAML identity provider, ALSO list that
# provider's logout page here and point ui_logout_url at it. Ending Cognito's
# session does not end the IdP's, so without this the IdP answers the next
# sign-in with no prompt and sign-out only appears to have worked. Cognito
# refuses any logout_uri that is not on this list - with HTTP 400 "Required
# parameters missing", not a redirect - so this entry must be applied BEFORE a
# UI build that uses it is deployed.
#
# For BU's test IdP that page is https://shib-test.bu.edu/idp/profile/Logout -
# the IdP's real logout flow. Do NOT use /idp/logout.jsp: it answers 200 with
# "You have successfully logged out" but leaves the live session cookie
# __Host-shib_idp_session intact, and the user is silently signed back in
# (clean-browser test, 2026-10-23). It expires shib_idp_session,
# shib_idp_session_ss, _idp_session and JSESSIONID at Path=/idp, none of which
# is a name the IdP sets - it predates the __Host- prefix.
cognito_logout_urls = [
  "https://REPLACE_WITH_YOUR_UI_DOMAIN/",
  "https://REPLACE_WITH_YOUR_UI_DOMAIN/signed-out",
  # "https://shib-test.bu.edu/idp/profile/Logout",
]
cognito_advanced_security_mode = "AUDIT"   # OFF, AUDIT, or ENFORCED
cognito_deletion_protection    = "INACTIVE" # ACTIVE or INACTIVE
cognito_mfa_configuration      = "OFF"     # OFF, ON, or OPTIONAL
# The UI's Amplify.configure() call requires a Hosted UI domain to
# initialize at all, even before any real browser-based login is
# tested - domain prefixes must be globally unique.
cognito_hosted_ui_domain_prefix = "REPLACE_WITH_A_GLOBALLY_UNIQUE_PREFIX"
# Dev/test convenience ONLY - lets a token be obtained for an
# admin-created user via `aws cognito-idp admin-initiate-auth`, no
# browser needed. Never enable this once real end users authenticate
# through Hosted UI/federation - see the variable's own doc in
# modules/cognito/variables.tf.
# cognito_allow_admin_password_auth = true

# Option B: bring your own existing User Pool that already exists *in
# this same AWS account* (confirm with `aws cognito-idp describe-user-pool
# --user-pool-id ...` first) - set manage_cognito = false and fill
# these in instead (delete the block above):
# manage_cognito           = false
# cognito_issuer_uri       = "https://cognito-idp.REGION.amazonaws.com/REPLACE_WITH_USER_POOL_ID"
# cognito_client_id        = "REPLACE_WITH_APP_CLIENT_ID"
# cognito_user_pool_id     = "REPLACE_WITH_USER_POOL_ID"
# # Only needed if manage_amplify = true below.
# cognito_hosted_ui_domain = "https://REPLACE_WITH_DOMAIN.auth.REGION.amazoncognito.com"

# --- Amplify / UI hosting --------------------------------------------------

# Option A (shown here): UI is hosted some other way; nothing to configure.
manage_amplify = false

# Option B: let Terraform create the Amplify app - set manage_amplify = true
# and fill these in. Leave amplify_repository_url/amplify_github_access_token
# BOTH unset (recommended) to connect the repo manually via the AWS Console's
# GitHub App flow after the first apply - see README's "Amplify repository
# connection" section. If you use the legacy PAT-based flow instead, set
# both (never put the token in this file - export
# TF_VAR_amplify_github_access_token instead).
# manage_amplify          = true
# amplify_repository_url  = "https://github.com/REPLACE_WITH_ORG/REPLACE_WITH_REPO"
# amplify_branch_name     = "main"
# ui_redirect_url         = "http://localhost:5173/"  # see README bring-up note
# ui_logout_url           = "http://localhost:5173/"
#
# With SAML federation enabled, ui_logout_url is the identity provider's
# logout page rather than one of our own URLs - that redirect is what ends the
# IdP session. It must already be in cognito_logout_urls above.
# ui_logout_url           = "https://shib-test.bu.edu/idp/profile/Logout"

# --- AI feature (optional) --------------------------------------------------

# Leave false (the default) to deploy without ever requiring an OpenAI
# secret - the API falls back to the deterministic stub AI provider. See
# README's "Enable and populate the OpenAI secret" section to turn this on.
# enable_openai_secret = true
# additional_api_environment_variables = {
#   APP_AI_ENABLED        = "true"
#   APP_AI_PROVIDER       = "openai"
#   APP_AI_OPENAI_ENABLED = "true"
# }

# --- BU Shibboleth SSO (see docs/shibboleth/RUNBOOK.md) ---------------------
#
# Setting shibboleth_idp_metadata_url is the single switch that creates the
# Cognito SAML identity provider named "BUShibboleth". "COGNITO" stays in the
# app client's supported_identity_providers either way, so native logins keep
# working as a fallback.
# shibboleth_idp_metadata_url        = "https://shib-test.bu.edu/idp/shibboleth"
# shibboleth_require_signed_requests = true
#
# ui_identity_provider switches the DEPLOYED site to redirect straight to BU
# Web Login. Leave it unset until the IdP operator confirms the SP
# registration, or real users get "Unsupported Request".
# ui_identity_provider = "BUShibboleth"
